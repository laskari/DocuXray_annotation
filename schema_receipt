class Totals(StrictModel):

    # --- Discounts ---
    discountTotal: Optional[NumericValue] = Field(
        None,
        description=(
            "CRITICAL: Extract exclusively the total, finalized monetary discount amount explicitly "
            "printed within the invoice summary/totals section. Valid triggers include literal labels "
            "like 'Discount', 'Less discount', 'Trade Discount', or 'Promotional Discount' applied to the final subtotal. "
            "Strictly output null if no explicit monetary discount value is physically printed in the document."
        ),
    )
    
    discountPercentage: Optional[NumericValue] = Field(
        None,
        description=(
            "CRITICAL: Extract exclusively the total, overall discount percentage explicitly printed as a literal value "
            "within the summary/totals section (e.g., '5% discount', 'Less 10%'). "
            "Strictly isolate your extraction to this summary section text. "
            "Strictly output null if a summary percentage is absent. "
            "Strictly maintain a null value if a percentage would require calculation, mathematical inference, "
            "or aggregation from individual line-item values."
        ),
    )

    # --- Charges ---
    otherCharges: Optional[List[Charge]] = Field(
        None,
        description=(
            "Target: Document-level financial modifiers positioned independently from the primary itemized list. "
            "Action: Identify the specific verbatim text label and its directly associated monetary value. "
            "Scope: Capture all documented modifiers (charges, fees, Balance Forward etc.), encompassing positive, negative, and zero values. "
            "Constraint: Base all extractions exclusively on explicitly printed document text, ensuring total isolation from line-item values."
        ),
    )

# --- Payments & credits applied ---
    deposit: Optional[NumericValue] = Field(
        None,
        description=(
            "TASK: EXTRACT PRIOR PRE-PAYMENTS OR ADVANCES\n"
            "Execute the following 3-step reasoning process to determine the advance payment amount. Do not skip steps.\n\n"
            
            "STEP 1: EVALUATE TIMING AND CONTEXT\n"
            "Scan the document for amounts that were paid historically, prior to the current document being finalized. "
            "Look for concepts indicating a pre-payment, such as 'Advance', 'Deposit', 'Down Payment', or 'Prior Credit'. "
            "CRITICAL: A standard 'Amount Paid' line or a 'PAID' stamp indicating the current invoice was settled does NOT qualify. "
            "The value must explicitly represent money received in the past.\n\n"
            
            "STEP 2: VERIFY MATHEMATICAL REDUCTION\n"
            "Examine the mathematical relationship of this value to the document's totals. "
            "You must confirm that this amount acts specifically as a deduction, reducing the initial gross sum down to a smaller final remainder. "
            "If the amount does not mathematically reduce the total owed, the evaluation fails. Proceed to output null.\n\n"
            
            "STEP 3: EXTRACT VERBATIM\n"
            "Once located and verified as a mathematically applied prior advance, capture the exact string representing this amount. "
            "Copy the value verbatim, exactly as it appears (e.g., '-$200.00', '10%', '$100 advance'). "
            "If Step 1 or Step 2 failed, return null."
        ),
    )

    # --- FX ---
    exchangeRate: Optional[NumericValue] = Field(
        None,
        description=(
            "The exchange rate as printed on the document: number of home/reporting currency units "
            "per one unit of the invoice currency (e.g., if invoice is in USD and home currency is INR, "
            "this would be ~83.5). Extract only if explicitly stated."
        ),
    )

    # --- Tax ---
    taxName: Optional[str] = Field(
        default=None,
        description=(
            "The specific jurisdictional or statutory name of the tax. Extract exclusively from visible document text.\n"
            "Constraints:\n"
            "1. Primary Target: Extract VERBATIM only if the printed label contains a specific statutory identifier, acronym, or jurisdictional modifier (e.g., 'VAT', 'GST', 'HST', 'State Tax', 'City Tax').\n"
            "2. Null Condition: If the printed label is solely a generic indicator without a specific statutory category identifier, assign null.\n"
            "3. Extraction Zone: Locate this value exclusively outside the primary itemized goods/services block. Transcribe exactly as physically printed without inference."
        )
    )
    
    taxAmount: Optional[NumericValue] = Field(
        default=None,
        description=(
            "The overall total tax amount.\n"
            "CONSTRAINTS:\n"
            "1. Extract VERBATIM exactly as shown outside the primary itemized goods/services section of the document.\n"
            "2. DO NOT calculate, infer, or sum individual tax line items.\n"
            "3. Return null if a definitive total tax amount is not explicitly printed."
        )
    )

    taxPercentage: Optional[NumericValue] = Field(None,description=(
            "The explicit tax rate or percentage if printed in the document (e.g., '0.00%', '18', 'VAT Rate'). "
            "Extract ONLY when explicitly present alongside or clearly associated with the taxAmount. "
        ),
    )

    # --- Grand total ---
    totalIncludingTax: Optional[NumericValue] = Field(
        default=None,
        description=(
            "The absolute final amount. To select the correct printed string, evaluate using this rule:\n"
